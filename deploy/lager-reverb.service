[Unit]
Description=Diagen Lager realtime WebSocket server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/domains/lager.diagen.am
ExecStart=/usr/bin/php8.2 artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

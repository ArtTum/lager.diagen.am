APP_NAME="Diagen Lager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lager.diagen.am
APP_LOCALE=hy
APP_TIMEZONE=Asia/Yerevan
CORS_ALLOWED_ORIGINS=https://lager.diagen.am
APP_FALLBACK_LOCALE=hy
APP_FAKER_LOCALE=hy_AM

LOG_CHANNEL=stack
